# Response headers applied to every static asset (parsed by Workers, not served as a file).
# Mirrors BASE_HEADERS in worker.js so API responses and 404s carry the same set.
/*
X-Content-Type-Options: nosniff
Referrer-Policy: strict-origin-when-cross-origin
X-Frame-Options: DENY
Strict-Transport-Security: max-age=31536000
Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'
Cache-Control: public, max-age=300
